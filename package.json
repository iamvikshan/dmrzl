{
  "name": "dmrzl",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:nkrn": "bun scripts/build.ts --package nkrn",
    "build:all": "bun scripts/build.ts",
    "publish:nkrn": "bun scripts/publish.ts --package nkrn",
    "test": "bun run --workspaces test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check && bun run --workspaces check",
    "prepare": "test -d .git && husky || true",
    "bs": "mkdir -p scripts && curl -sL https://raw.githubusercontent.com/iamvikshan/.github/main/scripts/bootstrap.sh > scripts/bootstrap.sh && chmod +x scripts/bootstrap.sh && scripts/bootstrap.sh"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "husky": "^9.1.7",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2000",
    "typescript": "^6.0.3"
  }
}
